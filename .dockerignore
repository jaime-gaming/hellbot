# Keep the build context small and secrets out of the image.
.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]

# Runtime state and secrets — never bake these into an image
.env
data/
logs/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Developer-only material
tests/
docs/
assets/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
*.bat
*.vbs
*.spec
launcher/
launcher_main.py
