# --- Discord ---------------------------------------------------------------
DISCORD_TOKEN=your-bot-token-here
GUILD_ID=000000000000000000

# Target voice channel for "Welcome to Hell"
VOICE_CHANNEL_ID=1539756705997652079
# Text channel where announcements + the live progress message are posted
ANNOUNCE_CHANNEL_ID=000000000000000000

# --- Roles (IDs) -----------------------------------------------------------
# Required
GAMENIGHT_HOST_ROLE_ID=000000000000000000   # @gamenight host  (can run /hell start|stop|reset)
CLANKER_ROLE_ID=000000000000000000          # @clanker         (auto-kicked from the VC)

# Optional: only used to render real mentions in reward announcements.
# The bot never assigns roles — rewards are announcement-only.
HELL_ROLE_ID=                                # @hell         (32h)
HELLIST_ROLE_ID=                             # @hell-ist     (96h)
HELL_MASTER_ROLE_ID=                         # @hell master  (160h)
COOL_PEOPLE_ROLE_ID=                         # @cool people :D (final Top 3)

# --- Tuning (optional) -----------------------------------------------------
DATABASE_PATH=data/hell.sqlite3
MONITOR_INTERVAL=1            # VC check cadence in seconds
PROGRESS_INTERVAL=10          # progress message edit cadence in seconds
STARTUP_GRACE_SECONDS=15      # ignore VC reads right after boot (cold cache guard)
MAX_TICK_CREDIT_SECONDS=5     # max leaderboard credit per tick (downtime guard)
REQUIRE_OCCUPANTS_TO_START=true
LOG_LEVEL=INFO
