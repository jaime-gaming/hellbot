# --- Discord ---------------------------------------------------------------
DISCORD_TOKEN=your-bot-token-here
GUILD_ID=000000000000000000

# Target voice channel for "Welcome to Hell"
VOICE_CHANNEL_ID=1539756705997652079
# Text channel where announcements + the live progress message are posted
ANNOUNCE_CHANNEL_ID=000000000000000000

# --- Roles (IDs) -----------------------------------------------------------
# Required
# @gamenight host  (can run /hell start|stop|reset)
GAMENIGHT_HOST_ROLE_ID=000000000000000000
# @clanker         (auto-kicked from the VC)
CLANKER_ROLE_ID=000000000000000000

# Optional: only used to render real mentions in reward announcements.
# The bot never assigns roles — rewards are announcement-only.
# @hell         (32h)
HELL_ROLE_ID=
# @hell-ist     (96h)
HELLIST_ROLE_ID=
# @hell master  (160h)
HELL_MASTER_ROLE_ID=
# @cool people :D (final Top 3)
COOL_PEOPLE_ROLE_ID=

# --- Alive checks ("roll call") --------------------------------------------
# Every 1-6 hours the bot pings everyone in the VC: reply "Yes" within 5
# minutes or you are disconnected (leaderboard time is kept, rejoin anytime).
ALIVE_CHECK_ENABLED=true
ALIVE_CHECK_MIN_HOURS=1
ALIVE_CHECK_MAX_HOURS=6
ALIVE_CHECK_TIMEOUT_MINUTES=5
# true = only the exact string "Yes" counts; false also accepts yes/YES
ALIVE_CHECK_STRICT=false
# Where the roll call is posted. Empty = the voice channel's own text chat.
ALIVE_CHECK_CHANNEL_ID=

# --- Live log stream (DM'd to the operator) --------------------------------
# Mirrors everything that happens (joins, leaves, kicks, milestones, errors)
# to one user's DMs in real time, batched to stay inside Discord rate limits.
LOG_DM_ENABLED=true
# Jaime Gaming
LOG_DM_USER_ID=984083829767675965
# DEBUG | INFO (joins/leaves/milestones) | WARNING (problems only) | ERROR
LOG_DM_LEVEL=INFO
# how often buffered lines are shipped, in seconds
LOG_DM_FLUSH_SECONDS=3

# --- Tuning (optional) -----------------------------------------------------
DATABASE_PATH=data/hell.sqlite3
# VC check cadence in seconds
MONITOR_INTERVAL=1
# how often the live progress message is edited, in seconds
PROGRESS_INTERVAL=20
# ignore VC reads right after boot (cold cache guard)
STARTUP_GRACE_SECONDS=15
# empty VC -> this many seconds to get somebody back in before the run FAILS
# (a no-ping warning is posted in the announcement channel while it counts down)
EMPTY_VC_GRACE_SECONDS=15
# max leaderboard credit per tick (downtime guard)
MAX_TICK_CREDIT_SECONDS=5
# if the bot is down for up to this long, anyone who was in the VC before AND
# after the outage gets that time credited back instead of losing it
DOWNTIME_CREDIT_SECONDS=300
REQUIRE_OCCUPANTS_TO_START=true
# proof-of-life line in the log file
HEARTBEAT_MINUTES=15
# DM every contestant their personal stat card when the event ends
SEND_FINAL_DMS=true
# pause between those DMs, to stay friendly with Discord's rate limits
DM_DELAY_SECONDS=1
LOG_LEVEL=INFO
